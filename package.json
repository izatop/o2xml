{
    "name": "o2xml",
    "version": "0.3.2",
    "description": "Convert JavaScript objects to XML",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.2",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2"
    },
    "scripts": {
        "clean": "rimraf dist",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:typecheck": "tsc -p test/tsconfig.json",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "security": "bun audit",
        "build": "tsc",
        "postversion": "git push --tags && git push"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/izatop/o2xml.git"
    },
    "keywords": [
        "xml",
        "simple",
        "writer",
        "object",
        "json"
    ],
    "author": "Artur F. Bier <izatop@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/izatop/o2xml/issues"
    },
    "homepage": "https://github.com/izatop/o2xml#readme",
    "packageManager": "bun@1.3.14"
}
